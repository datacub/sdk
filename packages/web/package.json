{
  "name": "@datacub/web",
  "version": "0.4.3",
  "description": "datacub product analytics for websites. One line to install, private by default.",
  "keywords": [
    "analytics",
    "product-analytics",
    "web-analytics",
    "datacub",
    "arabic"
  ],
  "homepage": "https://docs.datacub.to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacub/sdk.git",
    "directory": "packages/web"
  },
  "bugs": "https://github.com/datacub/sdk/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/datacub.mjs"
    },
    "./flags": {
      "types": "./types/flags-npm.d.ts",
      "default": "./dist/flags.mjs"
    },
    "./feedback": {
      "types": "./types/feedback.d.ts",
      "default": "./dist/feedback.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.mjs",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p .",
    "test": "bun test",
    "test:browser": "playwright test",
    "pack:check": "bun scripts/pack-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tanstack/react-router": "1.170.46",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "author": "datacub (https://datacub.to)"
}
